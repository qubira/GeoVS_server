# Neon (Postgres) — puede ser el mismo proyecto que usa la landing page.
# IMPORTANTE: agrega &schema=geovs_accounts al final de ambas URLs. Este
# servidor y la landing page comparten la misma base de datos pero con
# esquemas de Postgres separados, para que `prisma db push` de un proyecto
# nunca toque las tablas del otro (ver prisma/schema.prisma).
DATABASE_URL="postgresql://<user>:<password>@<host>-pooler.<region>.aws.neon.tech/<database>?sslmode=require&schema=geovs_accounts"
DATABASE_URL_UNPOOLED="postgresql://<user>:<password>@<host>.<region>.aws.neon.tech/<database>?sslmode=require&schema=geovs_accounts"

# Secreto para firmar los tokens de sesion (JWT). Genera uno propio, por
# ejemplo: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="cambia-esto-por-un-valor-aleatorio-largo"
