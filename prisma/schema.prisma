generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

enum Role {
  player
  developer
  moderator
  admin
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  username     String    @unique
  passwordHash String
  age          Int
  role         Role      @default(player)
  blocked      Boolean   @default(false)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  lastLoginAt  DateTime?

  auditLogs      AuditLog[]
  connectionLogs ConnectionLog[]
  playSessions   PlaySession[]

  @@map("users")
}

// Historico de cambios: tanto ediciones de datos personales del propio
// usuario como acciones de moderacion/administracion (bloqueo, cambio de
// rol, eliminacion, etc.). `changedBy` guarda el id de quien hizo el cambio
// (puede ser el propio usuario o un admin/moderador distinto).
//
// userId es opcional y onDelete:SetNull a proposito: si se elimina la
// cuenta, el registro de auditoria (incluyendo el de la propia eliminacion)
// debe sobrevivir. `targetUsername`/`changedByUsername` guardan una copia
// del nombre en el momento del cambio, para que el historial siga siendo
// legible aunque alguna de las cuentas involucradas ya no exista.
model AuditLog {
  id                String   @id @default(cuid())
  userId            String?
  user              User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  targetUsername    String
  field             String
  oldValue          String?
  newValue          String?
  reason            String?
  changedBy         String?
  changedByUsername String?
  changedAt         DateTime @default(now())

  @@map("audit_logs")
  @@index([userId])
}

// Una fila por conexion (socket) de un usuario autenticado. Permite calcular
// tiempo de conexion acumulado total y por dia, y de donde se conecta
// (IP/pais) para el panel de administracion.
model ConnectionLog {
  id             String    @id @default(cuid())
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  ip             String?
  country        String?
  countryCode    String?
  connectedAt    DateTime  @default(now())
  disconnectedAt DateTime?
  durationSec    Int?

  @@map("connection_logs")
  @@index([userId])
  @@index([connectedAt])
}

// Una fila por tramo continuo de juego ACTIVO (room.state === 'playing') de un
// jugador autenticado en un nivel. Distinto de ConnectionLog: un jugador puede
// estar conectado (menu/lobby/perfil) mucho mas tiempo del que pasa realmente
// jugando. Metrica pura, no historial legal -> mismo onDelete que ConnectionLog.
model PlaySession {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  levelId     String
  roomCode    String?
  country     String?
  countryCode String?
  startedAt   DateTime  @default(now())
  endedAt     DateTime?
  durationSec Int?
  endReason   String? // 'finished' | 'eliminated' | 'round-ended' | 'disconnected'

  @@map("play_sessions")
  @@index([userId])
  @@index([startedAt])
  @@index([levelId])
}

// Pista/nivel creada desde el modulo "Crear" del panel de administracion.
// Se agrega a los 3 niveles fijos (level1/2/3.json), no los reemplaza — ver
// server/src/game/levels.js. `length` se recalcula siempre en el servidor a
// partir de `speedX`/`durationSec`, nunca se confia en lo que mande el
// cliente (es el campo que usa la fisica para decidir la meta).
model CustomLevel {
  id                 String   @id @default(cuid())
  name               String
  length             Int
  durationSec        Int
  speedX             Int?
  jumpVelocity       Int?
  backgroundImageUrl String?
  // Escala del fondo sobre el ajuste "cover" por defecto (1 = normal, >1
  // acerca/agranda, <1 aleja/achica) — ver como se aplica en
  // GeoVS_juego/src/screens/GameScreen.tsx.
  backgroundScale    Float?
  musicUrl           String?
  // Recorte del archivo de musica subido: solo se reproduce (y se repite en
  // loop) el tramo [musicStartSec, musicEndSec), no el archivo completo — ver
  // GeoVS_juego/src/screens/GameScreen.tsx. null en musicEndSec = hasta el
  // final del archivo.
  musicStartSec      Float    @default(0)
  musicEndSec        Float?
  obstacles          Json
  checkpoints        Json     @default("[0]")
  // Empieza en false (borrador): mientras no se publique, no aparece en el
  // listado de niveles del juego ni la puede seleccionar ningun jugador.
  // Publicar/despublicar es una accion separada de guardar (ver
  // PUT /admin/custom-levels/:id/publish), asi el admin puede seguir
  // editando sin que una pista a medio armar quede jugable por error.
  published          Boolean  @default(false)
  createdBy          String
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@map("custom_levels")
}

// Imagen subida por un admin para usar como skin de un obstaculo, ademas de
// los 3 PNG por defecto (spike/block/platform). `physicsType` sigue
// determinando la colision — la imagen es puramente visual.
model CustomObjectType {
  id          String   @id @default(cuid())
  name        String
  imageUrl    String
  physicsType String
  createdBy   String
  createdAt   DateTime @default(now())

  @@map("custom_object_types")
}

// Imagen subida por un admin para usar como cara/skin del avatar cubo (el
// unico tipo de avatar activo hoy). `kind` queda listo para otros tipos de
// avatar (pies/nave/robot) que aun no tienen logica de juego definida.
model CustomAvatar {
  id        String   @id @default(cuid())
  name      String
  imageUrl  String
  kind      String   @default("cube")
  // Igual que CustomLevel.published: borrador hasta que se publica
  // explicitamente (ver /content/custom-avatars, que solo expone los ya
  // publicados a los jugadores).
  published Boolean  @default(false)
  createdBy String
  createdAt DateTime @default(now())

  @@map("custom_avatars")
}
