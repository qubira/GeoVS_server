generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

enum Role {
  player
  developer
  moderator
  admin
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  username     String    @unique
  passwordHash String
  age          Int
  role         Role      @default(player)
  blocked      Boolean   @default(false)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  lastLoginAt  DateTime?

  auditLogs      AuditLog[]
  connectionLogs ConnectionLog[]
  playSessions   PlaySession[]

  @@map("users")
}

// Historico de cambios: tanto ediciones de datos personales del propio
// usuario como acciones de moderacion/administracion (bloqueo, cambio de
// rol, eliminacion, etc.). `changedBy` guarda el id de quien hizo el cambio
// (puede ser el propio usuario o un admin/moderador distinto).
//
// userId es opcional y onDelete:SetNull a proposito: si se elimina la
// cuenta, el registro de auditoria (incluyendo el de la propia eliminacion)
// debe sobrevivir. `targetUsername`/`changedByUsername` guardan una copia
// del nombre en el momento del cambio, para que el historial siga siendo
// legible aunque alguna de las cuentas involucradas ya no exista.
model AuditLog {
  id                String   @id @default(cuid())
  userId            String?
  user              User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  targetUsername    String
  field             String
  oldValue          String?
  newValue          String?
  reason            String?
  changedBy         String?
  changedByUsername String?
  changedAt         DateTime @default(now())

  @@map("audit_logs")
  @@index([userId])
}

// Una fila por conexion (socket) de un usuario autenticado. Permite calcular
// tiempo de conexion acumulado total y por dia, y de donde se conecta
// (IP/pais) para el panel de administracion.
model ConnectionLog {
  id             String    @id @default(cuid())
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  ip             String?
  country        String?
  countryCode    String?
  connectedAt    DateTime  @default(now())
  disconnectedAt DateTime?
  durationSec    Int?

  @@map("connection_logs")
  @@index([userId])
  @@index([connectedAt])
}

// Una fila por tramo continuo de juego ACTIVO (room.state === 'playing') de un
// jugador autenticado en un nivel. Distinto de ConnectionLog: un jugador puede
// estar conectado (menu/lobby/perfil) mucho mas tiempo del que pasa realmente
// jugando. Metrica pura, no historial legal -> mismo onDelete que ConnectionLog.
model PlaySession {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  levelId     String
  roomCode    String?
  country     String?
  countryCode String?
  startedAt   DateTime  @default(now())
  endedAt     DateTime?
  durationSec Int?
  endReason   String? // 'finished' | 'eliminated' | 'round-ended' | 'disconnected'

  @@map("play_sessions")
  @@index([userId])
  @@index([startedAt])
  @@index([levelId])
}

// Pista/nivel creada desde el modulo "Crear" del panel de administracion.
// Se agrega a los 3 niveles fijos (level1/2/3.json), no los reemplaza — ver
// server/src/game/levels.js. `length` se recalcula siempre en el servidor a
// partir de `speedX`/`durationSec`, nunca se confia en lo que mande el
// cliente (es el campo que usa la fisica para decidir la meta).
model CustomLevel {
  id                 String   @id @default(cuid())
  name               String
  length             Int
  durationSec        Int
  speedX             Int?
  jumpVelocity       Int?
  backgroundImageUrl String?
  // Escala del fondo sobre el ajuste "cover" por defecto (1 = normal, >1
  // acerca/agranda, <1 aleja/achica) — ver como se aplica en
  // GeoVS_juego/src/screens/GameScreen.tsx.
  backgroundScale    Float?
  musicUrl           String?
  // Recorte del archivo de musica subido: solo se reproduce (y se repite en
  // loop) el tramo [musicStartSec, musicEndSec), no el archivo completo — ver
  // GeoVS_juego/src/screens/GameScreen.tsx. null en musicEndSec = hasta el
  // final del archivo.
  musicStartSec      Float    @default(0)
  musicEndSec        Float?
  obstacles          Json
  checkpoints        Json     @default("[0]")
  // Empieza en false (borrador): mientras no se publique, no aparece en el
  // listado de niveles del juego ni la puede seleccionar ningun jugador.
  // Publicar/despublicar es una accion separada de guardar (ver
  // PUT /admin/custom-levels/:id/publish), asi el admin puede seguir
  // editando sin que una pista a medio armar quede jugable por error.
  published          Boolean  @default(false)
  createdBy          String
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@map("custom_levels")
}

// Imagen subida por un admin para usar como skin de un obstaculo, ademas de
// los 3 PNG por defecto (spike/block/platform). `physicsType` sigue
// determinando la colision — la imagen es puramente visual.
model CustomObjectType {
  id          String   @id @default(cuid())
  name        String
  imageUrl    String
  physicsType String
  createdBy   String
  createdAt   DateTime @default(now())

  @@map("custom_object_types")
}

// Copia persistida de cada mensaje de chat de sala (el broadcast en vivo
// sigue siendo puramente en memoria, ver socket/handlers.js chat:message) —
// para el modulo de moderacion "Conversaciones" del panel: buscar por
// palabra y, mas adelante, bloquear/alertar a partir de un mensaje puntual.
// userId es null para sesiones anonimas (sin cuenta, ver Room.js).
model ChatMessage {
  id        String   @id @default(cuid())
  roomCode  String
  userId    String?
  username  String
  text      String
  createdAt DateTime @default(now())

  @@map("chat_messages")
  @@index([userId])
  @@index([roomCode])
}

// Motivo de bloqueo/alerta, elegido de una lista desplegable al moderar
// (ver AccountBlock/Warning). Empieza sembrada con los 4 motivos pedidos
// (ver seed en la migracion inicial); la seccion "Configuracion" del panel
// permite agregar mas.
model BlockReason {
  id        String   @id @default(cuid())
  label     String   @unique
  createdAt DateTime @default(now())

  accountBlocks AccountBlock[]
  warnings      Warning[]

  @@map("block_reasons")
}

// Bloqueo de una cuenta. `User.blocked` es la fuente de verdad para el login
// (ya la revisaba requireAuth desde antes de este modulo); esta tabla es el
// HISTORIAL de motivos — permite reactivar (active:false) sin perder el
// registro de que paso y por que. `reason` es una relacion normal (no solo
// un string suelto) a proposito: asi Prisma rechaza por si solo borrar un
// BlockReason que todavia este en uso (ver DELETE /admin/block-reasons/:id).
model AccountBlock {
  id            String      @id @default(cuid())
  userId        String
  reasonId      String
  reason        BlockReason @relation(fields: [reasonId], references: [id])
  messageId     String?
  messageText   String?
  blockedBy     String
  blockedByName String
  active        Boolean     @default(true)
  createdAt     DateTime    @default(now())

  @@map("account_blocks")
  @@index([userId])
  @@index([reasonId])
}

// Alerta (llamado de atencion, NO bloqueo) mandada a una cuenta por un
// mensaje puntual. `delivered` se pone en true la primera vez que el juego
// se la muestra al jugador (al loguearse o al terminar una partida, lo que
// pase primero) para no repetirla dos veces. El conteo de Warning por
// usuario es lo que decide si ya se agoto el limite de 3 y toca bloquear en
// vez de alertar (ver POST /admin/moderation/warn).
model Warning {
  id           String      @id @default(cuid())
  userId       String
  reasonId     String
  reason       BlockReason @relation(fields: [reasonId], references: [id])
  messageId    String?
  messageText  String?
  issuedBy     String
  issuedByName String
  delivered    Boolean     @default(false)
  deliveredAt  DateTime?
  createdAt    DateTime    @default(now())

  @@map("warnings")
  @@index([userId])
  @@index([reasonId])
}

// Una fila por INSTANCIA de sala (el codigo se libera y se puede reusar mas
// adelante, asi que `code` no es unico por si solo — cada vez que se crea
// una sala nueva es una fila nueva). `peakPlayers` se actualiza en cada
// muestreo (ver metrics/roomLatencySampler.js); `endReason` distingue una
// sala que se vacio sola de una que un admin corto a la fuerza.
model RoomLog {
  id          String    @id @default(cuid())
  code        String
  mode        String
  levelId     String
  maxPlayers  Int
  createdAt   DateTime  @default(now())
  endedAt     DateTime?
  endReason   String? // 'emptied' | 'admin'
  endedBy     String? // username del admin, solo si endReason='admin'
  peakPlayers Int       @default(0)

  samples RoomLatencySample[]

  @@index([code])
  @@index([createdAt])
  @@map("room_logs")
}

// Foto periodica (ver metrics/roomLatencySampler.js, cada ~20s mientras la
// sala tiene jugadores) de la latencia real (ping/RTT) contra el servidor,
// agregada entre los jugadores conectados en ese momento — esto es lo que
// arma el grafico de lineas con picos de caida por sala.
model RoomLatencySample {
  id          String   @id @default(cuid())
  roomLogId   String
  roomLog     RoomLog  @relation(fields: [roomLogId], references: [id], onDelete: Cascade)
  takenAt     DateTime @default(now())
  avgRttMs    Int?
  minRttMs    Int?
  maxRttMs    Int?
  playerCount Int

  @@index([roomLogId])
  @@index([takenAt])
  @@map("room_latency_samples")
}

// IP bloqueada: nada se puede loguear/registrar/conectar desde ahi (ver
// enforcement en routes/auth.js y socket/handlers.js). `blockedBy` null =
// bloqueo automatico del sistema (una segunda cuenta bloqueada reincidiendo
// desde una IP donde ya hubo otra cuenta bloqueada — ver
// moderation/ipAutoBlock.js). "Que cuentas se loguearon en esta IP" se
// responde con ConnectionLog (ya tiene ip+userId), no hace falta otra tabla.
model IpBlock {
  id        String   @id @default(cuid())
  ip        String   @unique
  reason    String
  blockedBy String?
  createdAt DateTime @default(now())

  @@map("ip_blocks")
}

// Imagen subida por un admin para usar como cara/skin del avatar cubo (el
// unico tipo de avatar activo hoy). `kind` queda listo para otros tipos de
// avatar (pies/nave/robot) que aun no tienen logica de juego definida.
model CustomAvatar {
  id        String   @id @default(cuid())
  name      String
  imageUrl  String
  kind      String   @default("cube")
  // Igual que CustomLevel.published: borrador hasta que se publica
  // explicitamente (ver /content/custom-avatars, que solo expone los ya
  // publicados a los jugadores).
  published Boolean  @default(false)
  createdBy String
  createdAt DateTime @default(now())

  @@map("custom_avatars")
}
